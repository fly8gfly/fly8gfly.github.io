---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
---

<BaseLayout title="FLY8G">

<section class="hero">

  <div class="hero-overlay">

    <div class="hero-content">

      <p class="hero-eyebrow">
        FLY8G PILOT SUNGLASSES
      </p>

      <h1>
        SEE CLEARER.<br />
        FLY SAFER.
      </h1>

      <p class="hero-text">
        Purpose-built aviation sunglasses engineered
        for real cockpit conditions.
      </p>

      <a
        href="https://wildcrowd.com"
        class="hero-button"
      >
        Shop Fly8G At WildCrowd
      </a>

    </div>

  </div>

</section>

<section class="feature-strip">

  <div class="feature-item">
    ✈️ Enhanced Clarity
  </div>

  <div class="feature-item">
    ☀️ Dark Top Transition
  </div>

  <div class="feature-item">
    📟 Clear Instrument Visibility
  </div>

  <div class="feature-item">
    🛡️ Non-Polarized Aviation Safe
  </div>

</section>

<ComparisonSlider />

<footer class="footer">

  <div>
    © 2025 FLY8G
  </div>

  <div class="footer-links">
    <a href="https://wildcrowd.com">
      WildCrowd
    </a>
  </div>

</footer>

</BaseLayout>

<style>

:root {
  --blue: #2563eb;
}

/* PAGE */

body {
  background: #000;
  color: white;
  margin: 0;
  font-family: Inter, sans-serif;
}

/* HERO */

.hero {
  position: relative;

  min-height: 100vh;

  background-image:
    linear-gradient(
      to right,
      rgba(0,0,0,0.78) 0%,
      rgba(0,0,0,0.45) 42%,
      rgba(0,0,0,0.18) 100%
    ),
    url('/cockpit-hero.JPEG');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
}

.hero-overlay {
  width: 100%;
  padding: 8%;
}

.hero-content {
  max-width: 520px;
  padding-top: 4rem;
}

.hero-eyebrow {
  color: #60a5fa;

  letter-spacing: 4px;

  font-size: 0.9rem;

  margin-bottom: 1rem;
}

.hero h1 {
  font-size: clamp(3rem, 7vw, 6rem);

  line-height: 0.92;

  margin-bottom: 2rem;

  max-width: 700px;

  letter-spacing: -2px;
}

.hero-text {
  font-size: 1.2rem;

  line-height: 1.8;

  color: #d1d5db;

  margin-bottom: 2.5rem;

  max-width: 500px;
}

.hero-button {
  display: inline-block;

  background: var(--blue);
  color: white;

  padding: 1.1rem 2.2rem;

  border-radius: 999px;

  text-decoration: none;

  font-weight: 700;

  transition: 0.3s ease;
}

.hero-button:hover {
  background: #1d4ed8;
  transform: translateY(-3px);
}

/* FEATURE STRIP */

.feature-strip {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 1px;

  background: rgba(255,255,255,0.08);
}

.feature-item {
  padding: 1.5rem;

  background: #050505;

  text-align: center;

  font-size: 0.95rem;

  color: #e5e7eb;
}

/* FOOTER */

.footer {
  padding: 2rem 8%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-top: 1px solid rgba(255,255,255,0.08);

  background: #050505;
}

.footer-links a {
  color: #9ca3af;
  text-decoration: none;
}

/* TABLET */

@media (max-width: 900px) {

  .hero {
    min-height: 88vh;

    background-position: 68% center;
  }

  .hero-overlay {
    padding: 14% 8%;
  }

  .hero-content {
    max-width: 450px;
  }

  .feature-strip {
    grid-template-columns: 1fr 1fr;
  }

}

/* MOBILE */

@media (max-width: 640px) {

  .hero {
    min-height: 82vh;

    background-position: 74% center;
  }

  .hero-overlay {
    padding: 22% 8%;
  }

  .hero h1 {
    font-size: 3.6rem;
  }

  .hero-text {
    font-size: 1rem;
  }

  .feature-strip {
    grid-template-columns: 1fr;
  }

  .feature-item {
    padding: 1.2rem;
    font-size: 0.9rem;
  }

  .footer {
    flex-direction: column;
    gap: 1rem;
  }

}

</style>
