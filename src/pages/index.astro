---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
---

<BaseLayout title="FLY8G">

<section class="hero">

  <div class="hero-overlay">

    <div class="hero-content">

      <p class="hero-eyebrow">
        FLY8G PILOT SUNGLASSES
      </p>

      <h1>
        SEE CLEARER.<br />
        FLY SAFER.
      </h1>

      <p class="hero-text">
        Purpose-built aviation sunglasses engineered for real cockpit conditions.
      </p>

      <a
        href="https://wildcrowd.com"
        class="hero-button"
      >
        Shop Fly8G At WildCrowd
      </a>

    </div>

  </div>

</section>

<section class="feature-strip">

  <div class="feature-item">
    ✈️ Enhanced Clarity
  </div>

  <div class="feature-item">
    ☀️ Dark Top Transition
  </div>

  <div class="feature-item">
    📟 Clear Instrument Visibility
  </div>

  <div class="feature-item">
    🛡️ Non-Polarized Aviation Safe
  </div>

</section>

<ComparisonSlider />

<footer class="footer">

  <div>
    © 2025 FLY8G
  </div>

  <div class="footer-links">
    <a href="https://wildcrowd.com">
      WildCrowd
    </a>
  </div>

</footer>

</BaseLayout>

<style>

:root {
  --blue: #2563eb;
}

/* PAGE */

body {
  background: #000;
  color: white;
  margin: 0;
  font-family: Inter, sans-serif;
}

/* HERO */

.hero {
  position: relative;

  min-height: 100vh;

  background-image:
    linear-gradient(
      to bottom,
      rgba(0,0,0,0.25),
      rgba(0,0,0,0.55)
    ),
    url('/cockpit-hero.JPEG');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
}

.hero-overlay {
  width: 100%;
  padding: 8%;
}

.hero-content {
  max-width: 650px;
}

.hero-eyebrow {
  color: #60a5fa;
  letter-spacing: 4px;
  font-size: 0.9rem;
  margin-bottom: 1rem;
}

.hero h1 {
  font-size: clamp(4rem, 10vw, 8rem);
  line-height: 0.9;
  margin-bottom: 2rem;
}

.hero-text {
  font-size: 1.3rem;
  line-height: 1.8;
  color: #d1d5db;

  margin-bottom: 2.5rem;

  max-width: 600px;
}

.hero-button {
  display: inline-block;

  background: var(--blue);
  color: white;

  padding: 1.2rem 2.4rem;

  border-radius: 999px;

  text-decoration: none;
  font-weight: 700;

  transition: 0.3s ease;
}

.hero-button:hover {
  background: #1d4ed8;
  transform: translateY(-3px);
}

/* FEATURE STRIP */

.feature-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  gap: 1px;

  background: rgba(255,255,255,0.08);
}

.feature-item {
  padding: 2rem;

  background: #050505;

  text-align: center;

  font-size: 1rem;
  color: #e5e7eb;
}

/* FOOTER */

.footer {
  padding: 2rem 8%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-top: 1px solid rgba(255,255,255,0.08);

  background: #050505;
}

.footer-links a {
  color: #9ca3af;
  text-decoration: none;
}

/* MOBILE */

@media (max-width: 900px) {

  .hero {
    min-height: 85vh;
    background-position: 72% center;
  }

  .hero-overlay {
    padding: 20% 8%;
  }

  .hero h1 {
    font-size: 4.5rem;
  }

  .hero-text {
    font-size: 1.1rem;
  }

  .feature-strip {
    grid-template-columns: 1fr 1fr;
  }

}

@media (max-width: 640px) {

  .hero {
    background-position: 74% center;
  }

  .hero h1 {
    font-size: 3.5rem;
  }

  .feature-strip {
    grid-template-columns: 1fr;
  }

}

</style>
