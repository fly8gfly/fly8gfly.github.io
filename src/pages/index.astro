---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- Theme Preloader Script -->
<script is:inline>
  (function() {
    const theme = localStorage.getItem('theme') || 'dark';

    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
  })();
</script>

<BaseLayout title="Fly8G - Aviation Sunglasses">

  <!-- HERO SECTION -->

  <section class="hero" aria-label="Fly8G Hero">

    <div class="hero-content">

      <!-- LEFT SIDE -->

      <div class="hero-text">

        <p class="hero-label">
          Aviation Sunglasses
        </p>

        <h1>
          SEE TRAFFIC<br />
          CLEARER.
        </h1>

        <p class="hero-description">
          Non-polarized aviation lenses engineered for cockpit visibility,
          reduced glare, and crystal-clear instrument readability.
        </p>

        <div class="hero-buttons">

          <a href="/products" class="primary-btn">
            Shop Sunglasses
          </a>

          <a href="#comparison" class="secondary-btn">
            See The Difference
          </a>

        </div>

      </div>

      <!-- RIGHT SIDE -->

      <div class="hero-image">

        <img
          src="/cockpit-hero.jpg"
          alt="Pilot wearing Fly8G sunglasses"
        />

        <div class="floating-card">

          <p class="floating-label">
            Lens Technology
          </p>

          <h3>
            Gradient Cockpit Tint
          </h3>

          <p>
            Dark upper transition blocks harsh sunlight while the lighter lower lens keeps gauges readable.
          </p>

        </div>

      </div>

    </div>

  </section>

  <!-- FEATURE CARDS -->

  <section class="card-grid">

    <a href="/products" class="card">
      <img src="/planes/plane1.png" alt="Products" loading="lazy" />
      <h3>Enhanced Aircraft Contrast</h3>
      <p>
        Special blue aviation tint designed to help aircraft stand out against haze and bright sky conditions.
      </p>
    </a>

    <a href="/products" class="card">
      <img src="/planes/plane3.png" alt="Cockpit Visibility" loading="lazy" />
      <h3>Gradient Cockpit Tint</h3>
      <p>
        Dark upper transition blocks harsh overhead sunlight while the lighter lower lens keeps gauges easy to read.
      </p>
    </a>

    <a href="/products" class="card">
      <img src="/planes/plane4.png" alt="Non Polarized Lenses" loading="lazy" />
      <h3>Non-Polarized Aviation Safe</h3>
      <p>
        No LCD blackout, rainbow distortion, or instrument display interference while flying.
      </p>
    </a>

  </section>

</BaseLayout>

<style>

  /* LIGHT MODE */

  :root {
    --bg: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    --surface: #ffffff;
    --text: #111827;
    --muted: #374151;
    --accent: #2563eb;
    --shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    --card-bg: rgba(255, 255, 255, 0.85);
  }

  /* DARK MODE */

  [data-theme="dark"] {
    --bg: linear-gradient(135deg, #050b14 0%, #0f172a 100%);
    --surface: #111827;
    --text: #ffffff;
    --muted: #94a3b8;
    --accent: #3b82f6;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    --card-bg: rgba(15, 23, 42, 0.9);
  }

  /* BODY */

  body {
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: background 0.3s ease, color 0.3s ease;
  }

  /* HERO SECTION */

  .hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 5rem 1.5rem;
  }

  .hero-content {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-label {
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--accent);
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
  }

  .hero h1 {
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.92;
    margin-bottom: 2rem;
    font-weight: 900;
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.7;
    max-width: 600px;
    color: var(--muted);
    margin-bottom: 2.5rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn,
  .secondary-btn {
    padding: 1rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .primary-btn {
    background: var(--accent);
    color: white;
  }

  .primary-btn:hover {
    transform: translateY(-2px);
  }

  .secondary-btn {
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--text);
  }

  .secondary-btn:hover {
    border-color: var(--accent);
  }

  /* HERO IMAGE */

  .hero-image {
    position: relative;
  }

  .hero-image img {
    width: 100%;
    border-radius: 28px;
    box-shadow: var(--shadow);
    object-fit: cover;
  }

  /* FLOATING CARD */

  .floating-card {
    position: absolute;
    bottom: -30px;
    left: -30px;
    background: var(--card-bg);
    backdrop-filter: blur(14px);
    padding: 2rem;
    border-radius: 22px;
    max-width: 320px;
    box-shadow: var(--shadow);
  }

  .floating-label {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .floating-card h3 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .floating-card p {
    color: var(--muted);
    line-height: 1.6;
  }

  /* FEATURE GRID */

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1300px;
    margin: 6rem auto;
    padding: 0 1.5rem;
  }

  .card {
    background: var(--card-bg);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: var(--shadow);
    text-align: center;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
  }

  .card img {
    width: 120px;
    margin-bottom: 1.5rem;
  }

  .card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .card p {
    line-height: 1.7;
    color: var(--muted);
  }

  /* MOBILE */

  @media (max-width: 900px) {

    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero {
      padding-top: 3rem;
    }

    .floating-card {
      position: relative;
      left: 0;
      bottom: 0;
      margin-top: 1.5rem;
      max-width: 100%;
    }

    .hero h1 {
      font-size: 4rem;
    }

  }

</style>