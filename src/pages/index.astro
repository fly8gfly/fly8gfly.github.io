---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
---

<BaseLayout title="FLY8G">

<section class="hero">

  <div class="hero-overlay">

    <div class="hero-content"></div>

  </div>

</section>

<section class="feature-strip">

  <div class="feature-item">
    ✈️ Enhanced Clarity
  </div>

  <div class="feature-item">
    ☀️ Dark Top Transition
  </div>

  <div class="feature-item">
    📟 Clear Instrument Visibility
  </div>

  <div class="feature-item">
    🛡️ Non-Polarized Aviation Safe
  </div>

</section>

<ComparisonSlider />

<footer class="footer">

  <div>
    © 2025 FLY8G
  </div>

  <div class="footer-links">
    <a href="https://wildcrowd.com">
      WildCrowd
    </a>
  </div>

</footer>

</BaseLayout>

<style>

body {
  background: #000;
  color: white;
  margin: 0;
  font-family: Inter, sans-serif;
}

/* HERO */

.hero {
  position: relative;

  min-height: 100vh;

  background-image: url('/cockpit-hero.JPEG');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
}

/* FEATURE STRIP */

.feature-strip {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 1px;

  background: rgba(255,255,255,0.08);
}

.feature-item {
  padding: 1.5rem;

  background: #050505;

  text-align: center;

  font-size: 0.95rem;

  color: #e5e7eb;
}

/* FOOTER */

.footer {
  padding: 2rem 8%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-top: 1px solid rgba(255,255,255,0.08);

  background: #050505;
}

.footer-links a {
  color: #9ca3af;
  text-decoration: none;
}

/* TABLET */

@media (max-width: 900px) {

  .hero {
    min-height: 88vh;

    background-position: center;
  }

  .feature-strip {
    grid-template-columns: 1fr 1fr;
  }

}

/* MOBILE */

@media (max-width: 640px) {

  .hero {
    min-height: 70vh;

    background-position: center;
  }

  .feature-strip {
    grid-template-columns: 1fr;
  }

  .feature-item {
    padding: 1.2rem;
    font-size: 0.9rem;
  }

  .footer {
    flex-direction: column;
    gap: 1rem;
  }

}

</style>
