---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
---

<BaseLayout title="FLY8G">

<section class="hero"></section>

<section class="feature-strip">

  <div class="feature-item">
    Enhanced Aircraft Contrast
  </div>

  <div class="feature-item">
    Dark Upper Gradient
  </div>

  <div class="feature-item">
    Clear Cockpit Visibility
  </div>

  <div class="feature-item">
    Aviation-Safe Non-Polarized
  </div>

</section>

<ComparisonSlider />

<section class="cta-section">

  <a
    href="https://wildcrowd.com"
    class="cta-button"
  >
    Shop Fly8G At WildCrowd
  </a>

</section>

<style>

/* HERO */

.hero {

  width: 100%;

  height: 100vh;

  background-image: url('/cockpit-hero.JPEG');

  background-size: cover;

  background-position: center;

  background-repeat: no-repeat;
}

/* FEATURE STRIP */

.feature-strip {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  border-top:
    1px solid rgba(255,255,255,0.08);

  border-bottom:
    1px solid rgba(255,255,255,0.08);

  background:
    linear-gradient(
      to bottom,
      rgba(255,255,255,0.02),
      rgba(255,255,255,0.01)
    );

  backdrop-filter: blur(10px);
}

.feature-item {

  padding: 1.6rem 1rem;

  text-align: center;

  font-size: 0.82rem;

  letter-spacing: 2px;

  text-transform: uppercase;

  color: rgba(255,255,255,0.82);

  border-right:
    1px solid rgba(255,255,255,0.06);
}

.feature-item:last-child {
  border-right: none;
}

/* CTA */

.cta-section {

  padding: 5rem 2rem;

  display: flex;

  justify-content: center;

  background: #050505;
}

.cta-button {

  background: #2563eb;

  color: white;

  padding: 1.2rem 2.8rem;

  border-radius: 999px;

  font-weight: 700;

  letter-spacing: 0.5px;

  transition: 0.3s ease;
}

.cta-button:hover {

  background: #1d4ed8;

  transform: translateY(-3px);
}

/* TABLET */

@media (max-width: 900px) {

  .hero {

    height: 82vh;

    background-position: center;
  }

  .feature-strip {

    grid-template-columns: 1fr 1fr;
  }

}

/* MOBILE */

@media (max-width: 640px) {

  .feature-strip {

    grid-template-columns: 1fr;
  }

  .feature-item {

    border-right: none;

    border-bottom:
      1px solid rgba(255,255,255,0.06);

    font-size: 0.78rem;
  }

}

</style>

</BaseLayout>
