---
const { title = "FLY8G" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content="FLY8G aviation sunglasses."
  />

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {

      width: 100%;
      overflow-x: hidden;

      background: #000;
      color: white;

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        sans-serif;
    }

    body {
      min-height: 100vh;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* HEADER */

    header {

      position: fixed;

      top: 0;
      left: 0;

      width: 100%;

      height: 78px;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 0 2rem;

      z-index: 1000;

      background:
        linear-gradient(
          to bottom,
          rgba(0,0,0,0.72),
          rgba(0,0,0,0)
        );

      backdrop-filter: blur(6px);
    }

    .logo img {

      height: 52px;
      width: auto;

      object-fit: contain;
    }

    /* MAIN */

    main {

      width: 100%;
      overflow: hidden;
    }

  </style>

</head>

<body>

  <header>

    <a
      href="/"
      class="logo"
      aria-label="FLY8G Home"
    >
      <img
        src="/logo.jpg"
        alt="FLY8G Logo"
      />
    </a>

  </header>

  <main>

    <slot />

  </main>

</body>

</html>
