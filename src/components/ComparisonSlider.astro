  pointer-events: none;
}

/* OVERLAY */

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
}

/* IMPORTANT FIX */

.overlay-image {
  position: absolute;
  top: 0;
  left: 0;

  width: 100cqw;
  height: auto;

  max-width: none;
  display: block;

  user-select: none;
  pointer-events: none;
}

/* SLIDER */

.slider {
  position: absolute;
  top: 0;
